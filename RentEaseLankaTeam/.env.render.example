# Render Web Service environment variables
# Add these in Render Dashboard -> Environment.
# Do not commit a file containing real values.

SPRING_PROFILES_ACTIVE=prod

# Render supplies PORT automatically. The application must be configured to use
# it; keep SERVER_PORT only as a local fallback.
SERVER_PORT=10000

# Azure SQL / managed SQL Server connection
DB_URL=jdbc:sqlserver://<sql-server-name>.database.windows.net:1433;databaseName=RentEaseLanka;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30
DB_USERNAME=<database-username>
DB_PASSWORD=<database-password>

# Generate a unique value for production; do not reuse the local secret.
JWT_SECRET_KEY=<long-random-production-secret>
